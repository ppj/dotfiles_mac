[core]
  excludesFile = ~/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[user]
  name = Prasanna Joshi
  email = prasanna_3003@yahoo.com
[pull]
  rebase = false
[push]
  default = current
[pager]
  branch = false
  diff = false
  log = true
[init]
  defaultBranch = main

# Some from https://blog.gitbutler.com/how-git-core-devs-configure-git/

[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true

# why the hell not?
[help]
  autocorrect = prompt
[commit]
  verbose = true
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

# Work identity is selected by the repository's remote org, not by its location
# on disk, so these same dotfiles work on both machines even though each keeps
# its projects under ~/code/. The [user] block above is the personal default;
# only a cultureamp remote overrides it. One entry per remote URL form.
#
# Keep last: git applies config in read order, so this must follow [user].
# Note that `remote.*.url` matches any remote, so a personal fork with a
# cultureamp upstream also picks up the work identity.
[includeIf "hasconfig:remote.*.url:git@github.com:cultureamp/**"]
  path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/cultureamp/**"]
  path = ~/.gitconfig-work
